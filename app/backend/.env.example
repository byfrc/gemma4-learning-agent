# ===== API server =====
APP_NAME=Gemma4 Private Learning Agent API
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ===== Model provider =====
# ollama: Windows 原生本地部署，调用本机 Ollama
# openai_compatible: 可选，调用 LM Studio、vLLM 等 OpenAI-compatible API
# mock: 前后端联调，不调用真实模型
MODEL_PROVIDER=ollama

# ===== Optional OpenAI-compatible provider =====
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=google/gemma4-learning

# ===== Login =====
# 初始管理员账号；系统首次启动时创建，正式部署前请修改默认值
# 登录页注册的新账号默认为学生，不能上传知识库
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
AUTH_SECRET_KEY=change-this-to-a-random-long-secret
SESSION_TTL_HOURS=12

# ===== Ollama =====
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:e4b

# ===== RAG =====
RAG_TOP_K_DEFAULT=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=90
MAX_UPLOAD_MB=30
DEFAULT_SUBJECT=ai

# ===== Document parsing =====
# auto: native text extraction first; use PaddleOCR when it is installed
# false: disable OCR fallback; true/required: fail clearly if OCR is unavailable
DOCUMENT_OCR_ENABLED=auto
DOCUMENT_OCR_LANG=ch
DOCUMENT_OCR_DEVICE=cpu
# Legacy .ppt files are converted by LibreOffice before parsing
OFFICE_CONVERTER=soffice
OFFICE_CONVERTER_TIMEOUT=120

# ===== Java online IDE =====
# Requires a JDK on the server. Student and admin accounts can run code
# after logging in with the Java subject selected.
JAVA_RUN_ENABLED=true
JAVA_JAVAC=javac
JAVA_RUNTIME=java
JAVA_TIMEOUT_SECONDS=5
JAVA_COMPILE_TIMEOUT_SECONDS=10
JAVA_MAX_CODE_KB=32
JAVA_MAX_STDIN_KB=8
JAVA_MAX_OUTPUT_KB=256

# ===== Paths =====
# 默认使用 app/backend/data 下的项目内目录，Windows 原生部署通常无需修改。
# 如需自定义路径，请填写 Windows 绝对路径，例如：
# KNOWLEDGE_DIR=C:\Gemma4\data\knowledge
# SUBJECT_BASE_DIR=C:\Gemma4\data\subjects
# RAG_INDEX_PATH=C:\Gemma4\data\hybrid_rag.joblib
# CHAT_LOG_PATH=C:\Gemma4\data\qa_history.jsonl
# FEEDBACK_LOG_PATH=C:\Gemma4\data\feedback.jsonl
